# ==========================================
# 本地开发环境配置示例
# 复制此文件为 application-local.properties 并填入真实值
# cp application-local.properties.example application-local.properties
# ==========================================

# JWT 密钥（至少 256 位，可用 openssl rand -base64 32 生成）
jwt.secret=your-very-secure-secret-key-that-is-long-enough
jwt.expiration=86400000

# QWeather 和风天气 API（从 https://dev.qweather.com 获取）
qweather.api.host=mx5ctu8gcb.re.qweatherapi.com
qweather.api.public-key=YOUR_PUBLIC_KEY
qweather.api.private-key=YOUR_PRIVATE_KEY
qweather.api.key-id=YOUR_KEY_ID
